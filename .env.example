# stub | gemini | groq | ollama   (stub runs offline with no key)
LLM_PROVIDER=stub
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Bounded reflection loop — how many critique cycles before forcing a verdict
MAX_ITERATIONS=3

# Local stores (swap for a Supabase Postgres URL later)
DRIFTBELL_DB=driftbell.db
CHECKPOINT_DB=checkpoints.db

# Shared secret. Set it once the service is exposed through a tunnel;
# n8n sends it as a Header Auth credential: Authorization: Bearer <token>
SERVICE_TOKEN=

# Public HTTPS base for n8n's generated webhook links. NOT optional for the
# Telegram approval loop: Telegram rejects inline keyboard buttons pointing at
# localhost ("Bad Request: ... is invalid: Wrong HTTP URL"), so no approval
# message can be sent without it. Take the value from the cloudflared container:
#   docker compose up -d cloudflared
#   docker compose logs cloudflared | grep trycloudflare.com
# then recreate n8n. Quick tunnels mint a new hostname on every restart.
WEBHOOK_URL=
